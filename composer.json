{
    "name": "liquiddesign/eshop",
    "description": "Ⓔ Služby, entity, administrace a kontroly pro eshop",
    "license": "MIT",
    "version": "2.1.382",
    "autoload": {
        "psr-4": {
            "Eshop\\": "src/"
        },
        "classmap": []
    },
    "autoload-dev": {
        "psr-4": {
            "Eshop\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "nette/application": "^3.1",
        "nette/http": "^3.2",
        "nette/utils": "^4.0",
        "league/csv": "^9.0",
        "liquiddesign/web": "^2.1",
        "liquiddesign/ares": "^2.0",
        "ext-pdo": "*",
        "ext-intl": "*",
        "ext-curl": "*",
        "guzzlehttp/guzzle": "^7.0",
        "mailerlite/mailerlite-api-v2-php-sdk": "^0.3.0",
        "ext-zip": "*",
        "mk-j/php_xlsxwriter": "^0.39.0",
        "ext-simplexml": "*",
        "erusev/parsedown": "^1.7",
        "contributte/comgate": "^0.5.0",
        "onnov/detect-encoding": "^2.0",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-soap": "*",
        "algolia/algoliasearch-client-php": "^3.1",
        "jurosh/pdf-merge": "^2.0",
        "salamek/ppl-my-api": "^2.5",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.0",
        "dvdoug/boxpacker": "^3.9",
        "markette/gopay-inline": "^2.1",
        "soukicz/zbozicz": "^1.2",
        "heureka/overeno-zakazniky": "^4.0",
        "dfridrich/qr-platba": "^2.0",
        "latte/latte": "^3.0",
        "ramsey/uuid": "^4.7",
        "liquiddesign/liquid-monitor-connector": "^1.0.19",
        "illuminate/database": "^11.0",
        "illuminate/support": "^11.0",
        "dave-liddament/php-language-extensions": "^0.9"
    },
    "minimum-stability": "stable",
    "require-dev": {
        "tracy/tracy": "^2.10",
        "composer/composer": "^2.0",
        "liquiddesign/codestyle": "^3.0.13",
        "liquiddesign/migrator": "~1.0",
        "phpstan/phpstan-nette": "~1.0",
        "marcocesarato/php-conventional-changelog": "^1.17",
        "pestphp/pest": "^3.1",
        "dave-liddament/phpstan-php-language-extensions": "^0.9",
        "phpstan/phpstan-deprecation-rules": "^1.2"
    },
    "scripts": {
        "fix-code": [
            "@phpcsfix"
        ],
        "code-style": [
            "@phpcsfix",
            "@phpcs"
        ],
        "check-code": [
            "@phpcs",
            "@phpstan",
            "@phpstan8",
            "@lattelint",
            "@check-commit"
        ],
        "phpstan-clear-cache": "@php ./vendor/bin/phpstan clear-result-cache",
        "phpstan": "@php ./vendor/bin/phpstan analyse --memory-limit 10G -c phpstan.neon --ansi",
        "phpstan8": "@php ./vendor/bin/phpstan analyse --memory-limit 10G -c phpstan8.neon --ansi",
        "phpcs": "@php ./vendor/bin/phpcs --standard=ruleset.xml --ignore=assets --cache src",
        "phpcsfix": "@php ./vendor/bin/phpcbf --standard=ruleset.xml --ignore=assets --cache src",
        "lattelint": "@php lattelint.php",
        "tester": "tester tests/Cases/*.phpt  -c tests/php.ini --setup tests/setup.php",
        "check-commit": "@php ./vendor/liquiddesign/codestyle/src/scripts/check-last-commit.php",
        "changelog": "@php ./vendor/bin/conventional-changelog",
        "release": "@php ./vendor/bin/conventional-changelog --patch --commit",
        "release:patch": "@php ./vendor/bin/conventional-changelog --patch --commit",
        "release:minor": "@php ./vendor/bin/conventional-changelog --minor --commit",
        "release:major": "@php ./vendor/bin/conventional-changelog --major --commit",
        "release:patch-full": [
            "@release:patch",
            "git push",
            "git push --tags"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    }
}