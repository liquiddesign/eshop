#!/usr/bin/env bash
# commit-msg hook — validates Conventional Commits format with required scope.
# Install: git config core.hooksPath scripts/hooks

commit_msg=$(head -1 "$1")

# Allow merge commits and reverts
if [[ "$commit_msg" =~ ^Merge\  ]] || [[ "$commit_msg" =~ ^Revert\  ]]; then
	exit 0
fi

# Conventional Commits pattern: type(scope): description
# Types: feat, fix, refactor, chore, docs, style, test, perf, ci, build
pattern='^(feat|fix|refactor|chore|docs|style|test|perf|ci|build)\([a-zA-Z0-9_-]+\): .+'

if [[ ! "$commit_msg" =~ $pattern ]]; then
	echo ""
	echo "ERROR: Commit message does not follow Conventional Commits format."
	echo ""
	echo "  Required: type(scope): description"
	echo ""
	echo "  Types:  feat, fix, refactor, chore, docs, style, test, perf, ci, build"
	echo "  Scope:  feature name (e.g., fakturace, checkout-gifts, shared, deps)"
	echo ""
	echo "  Examples:"
	echo "    feat(fakturace): add invoice export"
	echo "    fix(checkout-gifts): correct discount calculation"
	echo "    chore(shared): update dependencies"
	echo "    chore(deps): update abel-base dependency"
	echo ""
	echo "  Your message: $commit_msg"
	echo ""
	exit 1
fi
