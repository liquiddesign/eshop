{define content}
	<section class="content-header">
		<div class="container-fluid">
			<div class="row mb-1">
				<div class="col-sm-6">
					<h1>{$headerLabel}</h1>
				</div>
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item"><a href="{plink :Eshop:Admin:Dashboard:default}">Domů</a></li>
						{foreach $headerTree as $item}
							<li class="breadcrumb-item {if $iterator->isLast()}active{/if}">
								{ifset $item[1]}
									<a href="{plink $item[1]}">{$item[0]}</a>
								{else}
									{$item[0]}
								{/ifset}
							</li>
						{/foreach}
					</ol>
				</div>
			</div>
		</div>
	</section>

	<section class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-12">
					<div class="card">
						<div class="card-header">
							<h3 class="card-title">
								<i class="fas fa-file-alt mr-1"></i>
								Pipedrive Webhook Log
							</h3>
						</div>
						<div class="card-body">
							{if $logExists}
								<div class="mb-3">
									<span class="badge badge-secondary mr-2">
										<i class="fas fa-file mr-1"></i>
										{($logSize / 1024)|number:2, ',', ' '} KB
									</span>
									<span class="badge badge-secondary mr-2">
										<i class="fas fa-clock mr-1"></i>
										Poslední změna: {$logModified|date:'d.m.Y H:i:s'}
									</span>
									<span class="badge badge-info">
										<i class="fas fa-list mr-1"></i>
										{$filteredEntries} / {$totalEntries} záznamů
									</span>
									{if $filterLevel || $filterDateFrom || $filterDateTo}
										<span class="badge badge-warning">
											<i class="fas fa-filter mr-1"></i>
											Filtrováno
										</span>
									{/if}
								</div>

								{form filterForm, class => 'mb-3'}
									<div class="row align-items-end">
										<div class="col-auto">
											<label class="form-label small mb-1">Úroveň</label>
											{input level, class => 'form-control form-control-sm'}
										</div>
										<div class="col-auto">
											<label class="form-label small mb-1">Od</label>
											{input dateFrom, class => 'form-control form-control-sm'}
										</div>
										<div class="col-auto">
											<label class="form-label small mb-1">Do</label>
											{input dateTo, class => 'form-control form-control-sm'}
										</div>
										<div class="col-auto">
											{input filter, class => 'btn btn-primary btn-sm'}
											{input reset, class => 'btn btn-outline-secondary btn-sm'}
										</div>
									</div>
								{/form}

								<table class="table table-sm table-striped table-hover">
									<thead class="thead-light">
										<tr>
											<th style="width: 160px;">Čas</th>
											<th style="width: 80px;">Úroveň</th>
											<th>Zpráva</th>
										</tr>
									</thead>
									<tbody>
										{foreach $logEntries as $entry}
											<tr class="{if $entry['level'] === 'error'}table-danger{elseif $entry['level'] === 'warning'}table-warning{elseif $entry['level'] === 'success'}table-success{/if}">
												<td class="text-monospace text-muted" style="font-size: 0.85em;">
													{if $entry['timestamp']}
														{$entry['timestamp']}
													{else}
														<span class="text-muted">-</span>
													{/if}
												</td>
												<td>
													{if $entry['level'] === 'error'}
														<span class="badge badge-danger">ERROR</span>
													{elseif $entry['level'] === 'warning'}
														<span class="badge badge-warning">WARNING</span>
													{elseif $entry['level'] === 'success'}
														<span class="badge badge-success">SUCCESS</span>
													{else}
														<span class="badge badge-info">INFO</span>
													{/if}
												</td>
												<td class="text-monospace" style="font-size: 0.85em; word-break: break-all;">
													{$entry['message']}
												</td>
											</tr>
										{/foreach}
									</tbody>
								</table>

								{if $totalPages > 1}
									<nav class="mt-3">
										<ul class="pagination pagination-sm justify-content-center mb-0">
											<li class="page-item {if $currentPage <= 1}disabled{/if}">
												<a class="page-link" n:href="this, page => 1">
													<i class="fas fa-angle-double-left"></i>
												</a>
											</li>
											<li class="page-item {if $currentPage <= 1}disabled{/if}">
												<a class="page-link" n:href="this, page => $currentPage - 1">
													<i class="fas fa-angle-left"></i>
												</a>
											</li>

											{var $rangeStart = max(1, $currentPage - 2)}
											{var $rangeEnd = min($totalPages, $currentPage + 2)}

											{if $rangeStart > 1}
												<li class="page-item disabled"><span class="page-link">...</span></li>
											{/if}

											{for $i = $rangeStart; $i <= $rangeEnd; $i++}
												<li class="page-item {if $i === $currentPage}active{/if}">
													<a class="page-link" n:href="this, page => $i">{$i}</a>
												</li>
											{/for}

											{if $rangeEnd < $totalPages}
												<li class="page-item disabled"><span class="page-link">...</span></li>
											{/if}

											<li class="page-item {if $currentPage >= $totalPages}disabled{/if}">
												<a class="page-link" n:href="this, page => $currentPage + 1">
													<i class="fas fa-angle-right"></i>
												</a>
											</li>
											<li class="page-item {if $currentPage >= $totalPages}disabled{/if}">
												<a class="page-link" n:href="this, page => $totalPages">
													<i class="fas fa-angle-double-right"></i>
												</a>
											</li>
										</ul>
										<div class="text-center text-muted small mt-1">
											Stránka {$currentPage} z {$totalPages}
										</div>
									</nav>
								{/if}
							{else}
								<div class="alert alert-info">
									<i class="fas fa-info-circle mr-2"></i>
									Log soubor neexistuje nebo je prázdný.
								</div>
							{/if}
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
{/define}
