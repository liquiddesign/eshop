{block content}
	{if @$displayButtons}
		{foreach $displayButtons as $button}
			{$button|noescape}
		{/foreach}
	{/if}
	<br><br>
	{if @$displayControls}
		{foreach $displayControls as $ctr}
			{$ctr->render()}
		{/foreach}
	{/if}
{/block}

{block scripts}
<script>
document.addEventListener("DOMContentLoaded", function() {
	var form = document.querySelector("[data-pickup-config]");
	if (!form) return;

	var config = JSON.parse(form.dataset.pickupConfig);
	var typeSelect = form.querySelector("[name=type]");
	var pickupPointSelect = form.querySelector("[name=pickupPoint]");
	var pickupPointIdInput = form.querySelector("[name=pickupPointId]");
	var pickupPointNameInput = form.querySelector("[name=pickupPointName]");
	if (!typeSelect) return;

	function updatePickupVisibility() {
		var typeId = typeSelect.value;
		var hasPickup = config.typesWithPickup.indexOf(typeId) !== -1;
		var fields = [pickupPointSelect, pickupPointIdInput, pickupPointNameInput];

		fields.forEach(function(f) {
			if (!f) return;
			var wrapper = f.closest(".form-group") || f.parentElement;
			if (wrapper) wrapper.style.display = hasPickup ? "" : "none";
		});

		if (!hasPickup) {
			if (pickupPointSelect) pickupPointSelect.value = "";
			if (pickupPointIdInput) pickupPointIdInput.value = "";
			if (pickupPointNameInput) pickupPointNameInput.value = "";
		}

		if (hasPickup && pickupPointSelect && config.pointsByType[typeId]) {
			var points = config.pointsByType[typeId];
			var currentVal = pickupPointSelect.value;
			pickupPointSelect.innerHTML = '<option value="">-- Žádné --</option>';

			Object.keys(points).forEach(function(pk) {
				var opt = document.createElement("option");
				opt.value = pk;
				opt.textContent = points[pk];
				if (pk === currentVal) opt.selected = true;
				pickupPointSelect.appendChild(opt);
			});

			var wrapper = pickupPointSelect.closest(".form-group") || pickupPointSelect.parentElement;
			if (wrapper) wrapper.style.display = Object.keys(points).length > 0 ? "" : "none";
		} else if (pickupPointSelect) {
			var wrapper = pickupPointSelect.closest(".form-group") || pickupPointSelect.parentElement;
			if (wrapper) wrapper.style.display = "none";
		}
	}

	typeSelect.addEventListener("change", updatePickupVisibility);
	updatePickupVisibility();
});
</script>
{/block}

