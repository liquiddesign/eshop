includes:
	- vendor/phpstan/phpstan-nette/extension.neon
	- vendor/liquiddesign/storm/phpstan-extension.neon
	- vendor/dave-liddament/phpstan-php-language-extensions/extension.neon

parameters:
	universalObjectCratesClasses:
		- Nette\Http\SessionSection
		- Nette\Application\UI\Template
	level: 8
	paths:
		- src/Actions
		- src/DB/CartItemRepository.php
		- src/Services/LostPasswordService.php
		- src/Services/Order
		- src/Services/Comgate.php
		- src/Front/Web/SandboxPresenter.php
		- src/Front/Eshop/ExportPresenter.php
		- src/Admin/MerchantPresenter.php
		- src/Services/Order/OrderEditService.php
		- src/Admin/Controls/Customer
	excludePaths:
		- src/assets/*
		- src/templates/*