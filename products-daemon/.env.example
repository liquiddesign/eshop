# Copy to `.env` and fill values from /home/petr/abel/config/general.local.neon (section: database).
# The daemon reads this file at startup via `dotenvy::dotenv()` relative to the binary's CWD.
#
# SECURITY: never commit the real .env — it is in .gitignore.

# --- MariaDB connection (read-only role recommended) ---
DB_HOST=db
DB_PORT=3306
DB_USER=db
DB_PASSWORD=db
DB_NAME=db
DB_CONNECT_TIMEOUT_SECS=5
DB_POOL_MAX=4

# --- Runtime ---
# Where the daemon listens. Must match `eshop.rustDaemon.socketPath` in NEON.
SOCKET_PATH=/tmp/abel-products-daemon.sock

# --- Refresh cadence (three independent knobs) ---
# How often drift probe runs — cheap COUNT/MAX queries, sub-100 ms.
QUICK_CHECK_INTERVAL_SECS=60
# Floor between rebuilds — rate limit during import storms (drift can flip every minute overnight).
# During imports the daemon will rebuild at most once per this interval even if drift keeps changing.
MIN_REBUILD_INTERVAL_SECS=120
# Ceiling — safety net against the drift-probe UPDATE blind-spot. The probe misses in-place UPDATEs
# of existing rows (e.g. changing `eshop_price.price` by hand); this forces a rebuild anyway after N seconds.
MAX_FRESH_INTERVAL_SECS=300
# LEGACY alias for QUICK_CHECK_INTERVAL_SECS — kept so existing .env files on production keep working.
# If both are set, QUICK_CHECK_INTERVAL_SECS wins. Remove this line on new deployments.
REFRESH_INTERVAL_SECS=60

# tracing-subscriber EnvFilter string: `info`, `debug`, `abel_products_daemon=debug,mysql_async=info`
LOG_LEVEL=info
