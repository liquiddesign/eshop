# Copy to `.env` and fill values from /home/petr/abel/config/general.local.neon (section: database).
# The daemon reads this file at startup via `dotenvy::dotenv()` relative to the binary's CWD.
#
# SECURITY: never commit the real .env — it is in .gitignore.

# --- MariaDB connection (read-only role recommended) ---
DB_HOST=db
DB_PORT=3306
DB_USER=db
DB_PASSWORD=db
DB_NAME=db
DB_CONNECT_TIMEOUT_SECS=5
DB_POOL_MAX=4

# --- Runtime ---
# Where the daemon listens. Must match `eshop.rustDaemon.socketPath` in NEON.
SOCKET_PATH=/tmp/abel-products-daemon.sock
# How often the snapshot is refreshed (seconds). Drift detection runs more cheaply and may short-circuit.
REFRESH_INTERVAL_SECS=600
# tracing-subscriber EnvFilter string: `info`, `debug`, `abel_products_daemon=debug,mysql_async=info`
LOG_LEVEL=info
